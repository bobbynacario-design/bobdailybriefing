{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "daybook-grounding-watch/1",
  "title": "Daybook grounding watch file (complete snapshot)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generatedAt",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "daybook-grounding-watch/1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/watch"
      }
    }
  },
  "$defs": {
    "watch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "watchId",
        "seriesId",
        "state",
        "stateChangedAt",
        "detail"
      ],
      "properties": {
        "watchId": {
          "type": "string",
          "minLength": 1
        },
        "seriesId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_]{2,80}$"
        },
        "state": {
          "type": "string",
          "enum": [
            "awaiting_publication",
            "published",
            "overdue",
            "stale",
            "blocked",
            "withdrawn",
            "conflict"
          ]
        },
        "expectedBy": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "stateChangedAt": {
          "type": "string",
          "format": "date-time"
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/watchEvidence"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "watchEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "retrievedAt"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
