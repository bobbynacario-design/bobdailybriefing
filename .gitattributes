# Grounding releases are checked by SHA-256 over their exact bytes, so their
# line endings must never be converted on checkout (core.autocrlf is on here).
grounding/fixtures/** -text
grounding/schema/** eol=lf
# Consumers copy validate.js and fetch-release.js unmodified and check their
# SHA-256, so their bytes must be the same in every checkout.
grounding/validate.js eol=lf
grounding/fetch-release.js eol=lf
# Verbatim ABS responses used as test data; the CSV arrives with CRLF.
grounding/sources/fixtures/** -text
