rules_version = '2';

// ⚠️ STALE / REFERENCE ONLY — DO NOT DEPLOY FROM THIS REPO. ⚠️
//
// As of 2026-06-22 Firestore rule ownership is CENTRALIZED in the sonicvault
// repo. `sonicvault/firestore.rules` is the single source of truth for all
// three apps (PokerHQ, Daily Briefing, SonicVault) on project pokerhq-a67e4,
// and it is the only repo that deploys rules. The "rules" key has been removed
// from this repo's firebase.json (indexes are still deployed from here) so
// `firebase deploy` can no longer touch rules. This file is kept only for
// reference and may be out of date — to change Daily Briefing's rules, edit
// them in sonicvault/firestore.rules and deploy from there (./deploy-rules.ps1).

service cloud.firestore {
  match /databases/{database}/documents {

    function isBobGoogleAccount() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          'bobbynacario@gmail.com'
        ];
    }

    function isSonicVaultOwner() {
      return (request.auth != null && request.auth.token.sonicvaultOwner == true)
        || isBobGoogleAccount();
    }

    // ─────────────────────────────────────────────────────────────
    // PokerHQ — owner-locked, requires verified Google email
    // ─────────────────────────────────────────────────────────────
    match /pokerhq-bob/{docId} {
      allow read, write: if isBobGoogleAccount()
        && request.auth.token.email_verified == true;
    }
    match /{collection}/{docId} {
      allow read, write: if isBobGoogleAccount()
        && request.auth.token.email_verified == true
        && collection.matches('pokerhq-profile-.*');
    }

    // ─────────────────────────────────────────────────────────────
    // Bob's Daily Briefing — authenticated, uid-scoped
    // ─────────────────────────────────────────────────────────────
    match /briefings-bob/{docId} {
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || !('uid' in resource.data));

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;

      allow update: if request.auth != null
        && (resource.data.uid == request.auth.uid || !('uid' in resource.data))
        && request.resource.data.uid == request.auth.uid;

      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
    }

    // ─────────────────────────────────────────────────────────────
    // Bob's Daily Briefing — deep-research reports, uid-scoped
    // ─────────────────────────────────────────────────────────────
    match /reports-bob/{docId} {
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || !('uid' in resource.data));

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;

      allow update: if request.auth != null
        && (resource.data.uid == request.auth.uid || !('uid' in resource.data))
        && request.resource.data.uid == request.auth.uid;

      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid || !('uid' in resource.data));
    }

    // ─────────────────────────────────────────────────────────────
    // SonicVault — private vault locked to owner; public share
    // catalogs are world-readable but owner-writable only.
    // The watcher uses the Admin SDK and bypasses these rules.
    // ─────────────────────────────────────────────────────────────
    match /sonicvault-bob/{docId} {
      allow read, write, delete: if isSonicVaultOwner();
    }
    match /sonicvault-public-tracks/{docId} {
      allow read: if true;
      allow create, update, delete: if isSonicVaultOwner();
    }
    match /sonicvault-public-playlists/{docId} {
      allow read: if true;
      allow create, update, delete: if isSonicVaultOwner();
    }

    // ─────────────────────────────────────────────────────────────
    // Deny everything else (any unknown collection)
    // ─────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
